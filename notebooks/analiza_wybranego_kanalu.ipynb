    "duration_time = pd.to_timedelta(channel_info['duration'])\n",
    "channel_info['duration_minutes'] = (duration_time.dt.total_seconds() /60).round(2)\n",
    "print(\"Analiza kanału: \")\n",
    "print(channel_name)"
